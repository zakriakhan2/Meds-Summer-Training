#!/bin/bash

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

FILE=""
COMPARE_FILE=""
OUT_JSON="results.json"
FAIL_LOG="failures.log"

while getopts "f:c:o:" opt; do
  case $opt in
    f) FILE="$OPTARG" ;;
    c) COMPARE_FILE="$OPTARG" ;;
    o) OUT_JSON="$OPTARG" ;;
    *) exit 1 ;;
  esac
done

[ -z "$FILE" ] && exit 1

extract() {
  awk '{print $1, $2, $3}' "$1"
}

timestamp=$(date "+%Y-%m-%d %H:%M:%S")

echo "Run: $timestamp" > "$OUT_JSON"
echo "[" >> "$OUT_JSON"

PASS=0
FAIL=0

> "$FAIL_LOG"

while read -r name status msg; do

  if [ "$status" = "PASS" ]; then
    echo -e "${GREEN}$name PASS${NC}"
    PASS=$((PASS + 1))
  else
    echo -e "${RED}$name FAIL${NC}"
    FAIL=$((FAIL + 1))
    echo "$name | $msg" >> "$FAIL_LOG"
  fi

  echo "{\"test\":\"$name\",\"status\":\"$status\",\"msg\":\"$msg\"}," >> "$OUT_JSON"

done < <(extract "$FILE")

echo "]" >> "$OUT_JSON"

TOTAL=$((PASS + FAIL))

echo -e "\nSummary:"
echo "Total: $TOTAL | PASS: $PASS | FAIL: $FAIL"

# ---------------- REGRESSION MODE ----------------

if [ -n "$COMPARE_FILE" ]; then
  echo -e "\n${YELLOW}Regression Report:${NC}"

  while read -r name status; do
    prev=$(grep "^$name " "$COMPARE_FILE" | awk '{print $2}')
    curr=$(grep "^$name " "$FILE" | awk '{print $2}')

    if [ "$prev" = "PASS" ] && [ "$curr" = "FAIL" ]; then
      echo -e "${RED}$name REGRESSION${NC}"
    fi

    if [ "$prev" = "FAIL" ] && [ "$curr" = "PASS" ]; then
      echo -e "${GREEN}$name FIXED${NC}"
    fi

  done < <(extract "$FILE")
fi
